generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HOD_SPORTS
  HEAD_OF_SPORTS
  COACH
  PARENT
  MEMBER
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  password_hash      String
  pin_hash           String?
  name               String
  role               Role           @default(PARENT)
  reset_token        String?
  reset_token_expiry DateTime?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  attendances        Attendance[]
  children           Player[]       @relation("ParentChildren")
  forms              FormDocument[]

  @@map("users")
}

model Sport {
  id    String         @id @default(cuid())
  name  String         @unique
  teams Team[]
  forms FormDocument[]

  @@map("sports")
}

model Team {
  id          String       @id @default(cuid())
  name        String
  sport_id    String
  sport       Sport        @relation(fields: [sport_id], references: [id], onDelete: Cascade)
  players     Player[]
  fixtures    Fixture[]
  attendances Attendance[]

  @@unique([sport_id, name])
  @@map("teams")
}

model Player {
  id         String      @id @default(cuid())
  first_name String
  last_name  String
  house_name String?
  team_id    String?
  team       Team?       @relation(fields: [team_id], references: [id], onDelete: SetNull)
  parent_id  String?
  parent     User?       @relation("ParentChildren", fields: [parent_id], references: [id], onDelete: SetNull)
  selections Selection[]

  @@map("players")
}

model Fixture {
  id              String           @id @default(cuid())
  team_id         String
  team            Team             @relation(fields: [team_id], references: [id], onDelete: Cascade)
  opponent        String
  date_time       DateTime
  location        String
  is_away         Boolean          @default(false)
  bus_time        DateTime?
  status          String           @default("SCHEDULED")
  home_score      Int?
  away_score      Int?
  notes           String?
  selections      Selection[]
  cricket_innings CricketInnings[]

  @@index([date_time])
  @@index([status])
  @@map("fixtures")
}

model Selection {
  id         String  @id @default(cuid())
  fixture_id String
  fixture    Fixture @relation(fields: [fixture_id], references: [id], onDelete: Cascade)
  player_id  String
  player     Player  @relation(fields: [player_id], references: [id], onDelete: Cascade)
  position   String?

  @@unique([fixture_id, player_id])
  @@map("selections")
}

model Attendance {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  team_id    String
  team       Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  coach_id   String
  coach      User     @relation(fields: [coach_id], references: [id])
  records    String
  created_at DateTime @default(now())

  @@map("attendances")
}

model Notice {
  id         String   @id @default(cuid())
  title      String
  content    String
  type       String   @default("GENERAL")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("notices")
}

model CricketInnings {
  id                 String             @id @default(cuid())
  fixture_id         String
  fixture            Fixture            @relation(fields: [fixture_id], references: [id], onDelete: Cascade)
  batting_side       String
  innings_number     Int                @default(1)
  overs_limit        Int                @default(20)
  striker_id         String?
  non_striker_id     String?
  current_bowler_id  String?
  closed             Boolean            @default(false)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  batters            CricketBatter[]
  bowlers            CricketBowler[]
  deliveries         CricketDelivery[]

  @@unique([fixture_id, batting_side, innings_number])
  @@map("cricket_innings")
}

model CricketBatter {
  id            String         @id @default(cuid())
  innings_id    String
  innings       CricketInnings @relation(fields: [innings_id], references: [id], onDelete: Cascade)
  player_id     String?
  name          String
  batting_order Int
  how_out       String         @default("NOT_OUT")
  bowler_name   String?
  fielder_name  String?

  @@map("cricket_batters")
}

model CricketBowler {
  id             String         @id @default(cuid())
  innings_id     String
  innings        CricketInnings @relation(fields: [innings_id], references: [id], onDelete: Cascade)
  player_id      String?
  name           String
  bowling_order  Int

  @@map("cricket_bowlers")
}

model CricketDelivery {
  id             String         @id @default(cuid())
  innings_id     String
  innings        CricketInnings @relation(fields: [innings_id], references: [id], onDelete: Cascade)
  sequence       Int
  over_number    Int
  ball_in_over   Int
  bowler_id      String
  striker_id     String
  non_striker_id String
  runs_off_bat   Int            @default(0)
  extra_type     String?
  extra_runs     Int            @default(0)
  is_legal       Boolean        @default(true)
  wicket_type    String?
  dismissed_id   String?
  created_at     DateTime       @default(now())

  @@index([innings_id, sequence])
  @@map("cricket_deliveries")
}

model FormDocument {
  id           String   @id @default(cuid())
  title        String
  type         String
  sport_id     String?
  sport        Sport?   @relation(fields: [sport_id], references: [id], onDelete: SetNull)
  author_id    String
  author       User     @relation(fields: [author_id], references: [id])
  content_json String
  is_published Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("form_documents")
}
