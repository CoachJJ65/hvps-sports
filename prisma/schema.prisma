generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HOD_SPORTS
  HEAD_OF_SPORTS
  COACH
  PARENT
  MEMBER
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  password_hash      String
  pin_hash           String?
  name               String
  role               Role           @default(PARENT)
  reset_token        String?
  reset_token_expiry DateTime?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  attendances        Attendance[]
  children           Player[]       @relation("ParentChildren")
  forms              FormDocument[]

  @@map("users")
}

model Sport {
  id    String         @id @default(cuid())
  name  String         @unique
  teams Team[]
  forms FormDocument[]

  @@map("sports")
}

model Team {
  id          String       @id @default(cuid())
  name        String
  sport_id    String
  sport       Sport        @relation(fields: [sport_id], references: [id], onDelete: Cascade)
  players     Player[]
  fixtures    Fixture[]
  attendances Attendance[]

  @@unique([sport_id, name])
  @@map("teams")
}

model Player {
  id         String      @id @default(cuid())
  first_name String
  last_name  String
  house_name String?
  team_id    String?
  team       Team?       @relation(fields: [team_id], references: [id], onDelete: SetNull)
  parent_id  String?
  parent     User?       @relation("ParentChildren", fields: [parent_id], references: [id], onDelete: SetNull)
  selections Selection[]

  @@map("players")
}

model Fixture {
  id         String      @id @default(cuid())
  team_id    String
  team       Team        @relation(fields: [team_id], references: [id], onDelete: Cascade)
  opponent   String
  date_time  DateTime
  location   String
  is_away    Boolean     @default(false)
  bus_time   DateTime?
  status     String      @default("SCHEDULED")
  home_score Int?
  away_score Int?
  notes      String?
  selections Selection[]

  @@index([date_time])
  @@index([status])
  @@map("fixtures")
}

model Selection {
  id         String  @id @default(cuid())
  fixture_id String
  fixture    Fixture @relation(fields: [fixture_id], references: [id], onDelete: Cascade)
  player_id  String
  player     Player  @relation(fields: [player_id], references: [id], onDelete: Cascade)
  position   String?

  @@unique([fixture_id, player_id])
  @@map("selections")
}

model Attendance {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  team_id    String
  team       Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  coach_id   String
  coach      User     @relation(fields: [coach_id], references: [id])
  records    String
  created_at DateTime @default(now())

  @@map("attendances")
}

model Notice {
  id         String   @id @default(cuid())
  title      String
  content    String
  type       String   @default("GENERAL")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("notices")
}

model FormDocument {
  id           String   @id @default(cuid())
  title        String
  type         String
  sport_id     String?
  sport        Sport?   @relation(fields: [sport_id], references: [id], onDelete: SetNull)
  author_id    String
  author       User     @relation(fields: [author_id], references: [id])
  content_json String
  is_published Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("form_documents")
}
